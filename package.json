{
  "name": "tune-sdk",
  "version": "0.4.0",
  "description": "chat with llm in a text file. core package",
  "main": "dist/tune.js",
  "module": "dist/tune.mjs",
  "bin": {
    "tune": "bin/cli.js",
    "tune-sdk": "bin/cli.js"
  },
  "exports": {
    ".": {
      "require": "./dist/tune.js",
      "import": "./dist/tune.mjs"
    },
    "./cli": {
      "require": "./src/cli.js"
    },
    "./rpc": {
      "require": "./src/rpc.js"
    },
    "./contextws": {
      "require": "./src/contextws.js"
    },
    "./ws": {
      "require": "./src/ws.js"
    },
    "./man": {
      "require": "./src/man.js"
    }
  },
  "keywords": [
    "ai",
    "chat",
    "llm"
  ],
  "author": "Ilya Ovdin <iovdin@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/iovdin/tune"
  },
  "license": "MIT",
  "scripts": {
    "test": "node test/index.js",
    "test:watch": "node --watch test/index.js"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "mime-types": "^3.0.2",
    "ws": "^8.20.0"
  }
}
